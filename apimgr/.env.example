# apimgr 환경변수 예시 — 실제 값은 절대 커밋하지 않는다(규칙 §4.18/§0.14).
# 이 파일은 placeholder 만 담는다. 실값은 .env(gitignore) 또는 secret 관리로 주입.

# 인프라
# Supabase Postgres (직접 연결). [YOUR-PASSWORD] 자리에 실제 비밀번호는 .env(gitignore)에만 넣는다.
# ⚠️ 실제 비밀번호를 이 .example 파일이나 코드·채팅에 넣지 말 것.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.gtbdiiunozsbbdajmick.supabase.co:5432/postgres
JWT_SECRET=change-me-in-secret-manager

# Supabase Auth (JWKS ES256 토큰 검증). 미설정 시 인증 비활성 — 익명만 허용(선택적 인증).
SUPABASE_URL=https://gtbdiiunozsbbdajmick.supabase.co
JWT_AUDIENCE=authenticated

# 에셋 저장소 선택: LOCAL_DISK(기본, 자격증명 불필요) | SUPABASE(아래 키 필요)
ASSET_STORE_BACKEND=LOCAL_DISK
# LOCAL_DISK 루트(비우면 repo 밖 기본 경로). 고객 얼굴/결과 저장 → repo 밖 경로 권장(§4.13).
ASSET_LOCAL_ROOT=

# Studio 결과 저장 profile/prefix. 비밀값이 아니며 실제 root/bucket credential은 위 storage 설정이 결정한다.
STUDIO_STORAGE_PROFILE_NAME=local-dev
STUDIO_OUTPUT_PREFIX=studio/outputs
STUDIO_OUTPUT_RETENTION_DAYS=30

# 로컬 이미지 생성 추론 서비스(ml/serve.py) URL. 외부 URL은 서버가 거부한다.
LOCAL_INFERENCE_URL=http://127.0.0.1:8188
# 로컬 영상 생성 추론 서비스(ml/serve.py 또는 호환 서버) URL.
# DEFAULT_VIDEO_PROVIDER=SELF_HOSTED_WAN 으로 바꾼 경우에만 사용.
# 외부 URL은 서버가 거부한다.
LOCAL_VIDEO_INFERENCE_URL=http://127.0.0.1:8188
LOCAL_VIDEO_ENDPOINT_PATH=/video/i2v
LOCAL_VIDEO_TIMEOUT_SECONDS=900
SELF_HOSTED_WAN_VIDEO_MODEL=

# Supabase Storage (서버측 업로드용, ASSET_STORE_BACKEND=SUPABASE 일 때).
# ⚠️ 신형 secret 키(sb_secret_...) = service_role 역할. 실값은 이 .example/채팅/커밋에 절대 넣지 말고
#    .env(gitignore)에만. 노출되면 즉시 대시보드에서 Roll(폐기·재발급).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hairview-assets

# 스토리지 (Cloudflare R2 — 대안, 미사용 시 비움)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 외부 AI Provider (미설정 시 Mock 사용)
GEMINI_API_KEY=
PIXVERSE_API_KEY=
PIXVERSE_WEBHOOK_SECRET=
FAL_KEY=
WAN_API_KEY=

# Provider 선택 (기본 Mock)
DEFAULT_VIDEO_PROVIDER=MOCK
DEFAULT_IMAGE_PROVIDER=MOCK
DEFAULT_ANALYSIS_PROVIDER=MOCK
DEFAULT_STUDIO_DRAFT_PROVIDER=MOCK

# Studio script/storyboard 초안 생성(local Ollama 옵션).
# DEFAULT_STUDIO_DRAFT_PROVIDER=OLLAMA 로 바꾸고 로컬 Ollama 모델을 설치한 경우에만 사용.
# 예: ollama pull qwen3:8b 또는 설치한 다른 모델명. 모델명은 실 환경 .env 에만 지정한다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_STUDIO_DRAFT_MODEL=
OLLAMA_TIMEOUT_SECONDS=60

# 모델 토큰 (Registry — 하드코딩 금지, 실 모델명 확인 후 주입). unverified 외부 스펙.
PIXVERSE_VIDEO_MODEL=
FAL_WAN_VIDEO_MODEL=
GEMINI_IMAGE_MODEL=
