# hairsoui 환경변수 예시 — 실값은 .env.local(gitignore)에만 넣는다.
# NEXT_PUBLIC_* 는 브라우저 번들에 노출되므로 secret 을 넣지 않는다.

# BE API base URL. 개발 시 next.config 프록시(/api/*)를 쓰면 비워둔다.
NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth (FE 로그인). publishable key 는 클라이언트 노출용 공개 키(RLS 로 보호).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
